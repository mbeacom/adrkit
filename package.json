{
  "name": "adrkit",
  "version": "0.10.0",
  "description": "Decision memory for human and agent-authored plans \u2014 machine-readable, CI-enforceable architecture decision records.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "license": "Apache-2.0",
  "author": "Mark Beacom (@mbeacom)",
  "homepage": "https://github.com/mbeacom/adrkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbeacom/adrkit.git"
  },
  "bugs": {
    "url": "https://github.com/mbeacom/adrkit/issues"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bun run --filter='*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit --customConditions bun",
    "lint": "bun run --filter='*' lint",
    "schema:emit": "bun run --filter='@adrkit/core' schema:emit",
    "check:deps": "bun run scripts/check-deps.ts",
    "check:changelog": "bun run scripts/check-changelog.ts",
    "check:clean-clone": "bun run scripts/check-clean-clone.ts",
    "check:clause8": "bun run scripts/check-clause8-gate.ts",
    "check:no-spike-heuristics": "bun run scripts/check-no-spike-heuristics.ts",
    "check:freeze-hashes": "bun run scripts/check-freeze-hashes.ts",
    "check:doc-pins": "bun run scripts/check-doc-cli-versions.ts",
    "check:site-grammar": "bun run scripts/check-site-corpus-grammar.ts",
    "check:dco": "bun run scripts/check-dco.ts",
    "check:ci-comment": "bun run scripts/check-ci-comment.ts",
    "audit:gate": "bun run scripts/audit-gate.ts",
    "adr": "bun packages/cli/src/index.ts",
    "site:queue": "bun packages/cli/src/index.ts queue --format json > site/public/queue.json",
    "site:lint": "bun packages/cli/src/index.ts lint --json > site/public/lint.json",
    "release:pack": "bun scripts/release-pack.ts",
    "release:publish": "bun scripts/release-publish.ts",
    "release:action-tag": "bun scripts/update-action-tag.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6",
    "zod": "^4"
  }
}
